# Build artifacts (track the directory via .gitkeep)
build/*
!build/.gitkeep
*.o
*.a
*.so
moc_*
qrc_*
Makefile
.qmake.stash
*.pro.user
*.pro.user.*

# Board config — contains credentials (IP/password), never push
config/board.env
config/*.local
!config/.gitkeep
!config/board.env.example

# Editor/OS
.vscode/
.idea/
*~
*.swp
.DS_Store
