# Board configuration for Luckfox Pico Ultra W
# Copy this file to config/board.env and edit with your board's settings.
# The actual board.env is git-ignored (contains credentials).

# Board network settings
BOARD_IP=
BOARD_USER=
BOARD_PASS=
BOARD_DEST=/root

# Display settings (for running on board)
QT_QPA_PLATFORM=linuxfb:fb=/dev/fb0:size=800x480:mmsize=800x480
QT_QPA_FONTDIR=/usr/share/fonts/dejavu/
LD_LIBRARY_PATH=/usr/lib:/usr/lib/qt5/lib
