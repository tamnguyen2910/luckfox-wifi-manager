#!/usr/bin/expect -f
# Deploy script - called from build.sh with binary path as argument
# Reads board config from config/board.env (git-ignored, contains secrets).
#
# SECURITY (DR-06..10): StrictHostKeyChecking=no is for dev convenience
# on the Luckfox board which is re-flashed frequently.
# For production: remove -o StrictHostKeyChecking=no, pin host key via
# ssh-keyscan, and switch to SSH key-based auth (ssh-copy-id).

set timeout 30

# Parse board.env from argument
set env_file [lindex $argv 0]
set local_file [lindex $argv 1]

if {$env_file eq "" || $local_file eq ""} {
    puts "Usage: deploy.exp <board.env> <local_binary_path>"
    exit 1
}

# Parse key=value pairs from env file
set board_user ""
set board_pass ""
set board_ip ""
set board_dest ""

set fh [open $env_file r]
while {[gets $fh line] >= 0} {
    if {[string match "*=*" $line]} {
        set key [string range $line 0 [string first "=" $line]-1]
        set val [string range $line [string first "=" $line]+1 end]
        switch $key {
            "BOARD_USER" { set board_user $val }
            "BOARD_PASS" { set board_pass $val }
            "BOARD_IP"   { set board_ip $val }
            "BOARD_DEST" { set board_dest $val }
        }
    }
}
close $fh

if {$board_ip eq "" || $board_user eq "" || $board_pass eq ""} {
    puts "ERR: Missing board config in $env_file"
    puts "Copy config/board.env.example to config/board.env and set your board's IP/user/password"
    exit 1
}

# Kill old process
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null $board_user@$board_ip "pkill -9 wifi-manager 2>/dev/null; sleep 1; echo PREPOK"
expect {
    -re {password:} { send "$board_pass\r"; exp_continue }
    "PREPOK" { }
    timeout { puts "ERR_TIMEOUT_PREP"; exit 1 }
    eof { }
}

# SCP binary
spawn scp -o StrictHostKeyChecking=no $local_file $board_user@$board_ip:$board_dest/wifi-manager
expect {
    -re {password:} { send "$board_pass\r"; exp_continue }
    "100%" { }
    timeout { puts "ERR_TIMEOUT_SCP"; exit 1 }
    eof { }
}

# Chmod
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null $board_user@$board_ip "chmod +x $board_dest/wifi-manager && echo DEPLOYDONE"
expect {
    -re {password:} { send "$board_pass\r"; exp_continue }
    "DEPLOYDONE" { }
    timeout { puts "ERR_TIMEOUT_CHMOD"; exit 1 }
    eof { }
}

puts "DEPLOY COMPLETE"
